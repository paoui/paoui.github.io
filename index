<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<script>try{var t=localStorage.getItem('seed-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t;}catch(e){}</script>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Seed Scanner</title>
<style>
  * { box-sizing: border-box; border-radius: 0; }
  [hidden] { display: none !important; }
  ::selection { background: var(--ink); color: var(--paper); }

  /* Registering the colors lets the variables themselves animate,
     so every border, fill and text color fades together in one smooth pass. */
  @property --ink   { syntax: '<color>'; inherits: true; initial-value: #fff; }
  @property --paper { syntax: '<color>'; inherits: true; initial-value: #000; }
  @property --gray  { syntax: '<color>'; inherits: true; initial-value: #9a9a9a; }

  :root {
    /* night (default) */
    --ink: #fff;
    --paper: #000;
    --gray: #9a9a9a;
    color-scheme: dark;
    --theme-ease: cubic-bezier(.65, 0, .35, 1);
    transition: --ink .6s var(--theme-ease), --paper .6s var(--theme-ease), --gray .6s var(--theme-ease);
    --b: 3px;
    --sans: "Helvetica Neue", Helvetica, Arial, "Inter", sans-serif;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, "Courier New", monospace;
  }

  /* day */
  :root[data-theme="light"] {
    --ink: #000;
    --paper: #fff;
    --gray: #666;
    color-scheme: light;
  }

  /* While switching, only the root variables animate (avoids double-easing on buttons etc.) */
  .theme-switching *:not(.theme-toggle):not(.theme-toggle *) { transition: none !important; }

  /* Theme toggle */
  .theme-toggle {
    padding: 0; border: 0; background: transparent; box-shadow: none; gap: 10px;
    font: 700 11px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase;
  }
  .theme-toggle:hover, .theme-toggle:active { transform: none; box-shadow: none; }
  .theme-toggle:focus-visible { outline-offset: 4px; }
  .tt-track { position: relative; display: block; width: 46px; height: 22px; border: 2px solid var(--ink); }
  .tt-thumb {
    position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; background: var(--ink);
    transition: transform .55s var(--theme-ease);
  }
  .theme-toggle:hover .tt-thumb { transform: scale(.8); }
  :root[data-theme="light"] .tt-thumb { transform: translateX(24px); }
  :root[data-theme="light"] .theme-toggle:hover .tt-thumb { transform: translateX(24px) scale(.8); }
  .tt-label { display: inline-grid; min-width: 38px; text-align: left; }
  .tt-label > span { grid-area: 1 / 1; transition: opacity .35s ease, transform .55s var(--theme-ease); }
  .tt-label .d { opacity: 0; transform: translateY(8px); }
  :root[data-theme="light"] .tt-label .n { opacity: 0; transform: translateY(-8px); }
  :root[data-theme="light"] .tt-label .d { opacity: 1; transform: none; }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
  }
  button, textarea, input, select { font: inherit; color: inherit; }
  code { font-family: var(--mono); font-size: .88em; border: 2px solid var(--ink); padding: 1px 5px; }

  /* Sheet frame */
  .sheet { width: min(1240px, calc(100% - 32px)); margin: 24px auto; border: var(--b) solid var(--ink); }

  /* Meta bar */
  .meta { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: var(--b) solid var(--ink); font: 700 11px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; }
  .meta-end { display: flex; align-items: center; justify-content: flex-end; gap: 16px; padding: 12px 20px; }

  /* Tabs: the ink fill wipes in from the left on the active tab and out to the right on the old one */
  .tab {
    position: relative; isolation: isolate; width: 100%; justify-content: flex-start; gap: 0;
    padding: 12px 20px; border: 0; border-right: var(--b) solid var(--ink);
    background: transparent; color: var(--ink); box-shadow: none; text-align: left;
    font: 700 11px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase;
    transition: color .35s var(--theme-ease) .05s, box-shadow .25s cubic-bezier(.22,.8,.24,1);
  }
  .tab::before {
    content: ""; position: absolute; inset: 0; z-index: -1; background: var(--ink);
    transform: scaleX(0); transform-origin: right; transition: transform .5s var(--theme-ease);
  }
  .tab[aria-current="page"] { color: var(--paper); }
  .tab[aria-current="page"]::before { transform: scaleX(1); transform-origin: left; }
  .tab:hover, .tab:active { transform: none; box-shadow: none; }
  .tab:not([aria-current]):hover { box-shadow: inset 10px 0 0 var(--ink); }
  .tab:focus-visible { outline: 2px solid currentColor; outline-offset: -7px; }
  .tab .n { font-weight: 400; opacity: .6; margin-right: 12px; letter-spacing: 0; }

  .panel-status { font: 700 10px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; }

  /* Hero */
  .hero { display: grid; grid-template-columns: 1fr minmax(260px, 360px); gap: 32px; align-items: end; padding: 28px 24px 26px; border-bottom: var(--b) solid var(--ink); }
  h1 { margin: 0; font-size: clamp(54px, 11vw, 150px); line-height: .84; letter-spacing: -.055em; font-weight: 800; text-transform: uppercase; }
  .hero-note .label { font: 700 11px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; margin-bottom: 12px; display: block; }
  .subtitle { margin: 0; font-size: 14px; line-height: 1.6; font-weight: 500; }

  /* Grid */
  .grid { display: grid; grid-template-columns: 1.05fr .95fr; }
  .panel { min-width: 0; }
  .panel + .panel { border-left: var(--b) solid var(--ink); }
  .panel-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; background: var(--ink); color: var(--paper); padding: 10px 20px; min-height: 52px; }
  .panel-title { font-size: 13px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; display: flex; gap: 12px; align-items: baseline; }
  .panel-title .idx { font-family: var(--mono); font-weight: 400; opacity: .6; }
  .panel-body { padding: 20px; }

  /* Buttons */
  button {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    border: var(--b) solid var(--ink); background: var(--paper); color: var(--ink);
    padding: 12px 18px; cursor: pointer; font-weight: 800; font-size: 12px; letter-spacing: .1em; text-transform: uppercase;
    box-shadow: 4px 4px 0 var(--ink);
    transition: transform .18s cubic-bezier(.22,.8,.24,1), box-shadow .18s cubic-bezier(.22,.8,.24,1), background .18s ease, color .18s ease;
  }
  button:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--ink); }
  button:active { transform: translate(4px, 4px); box-shadow: 0 0 0 var(--ink); }
  button:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
  button.primary { background: var(--ink); color: var(--paper); box-shadow: none; }
  button.primary:hover { background: var(--paper); color: var(--ink); box-shadow: 6px 6px 0 var(--ink); }
  button.done { background: var(--ink) !important; color: var(--paper) !important; }
  button:disabled { opacity: .35; cursor: not-allowed; transform: none; box-shadow: none; }

  .head-btn { border: 2px solid var(--paper); background: transparent; color: var(--paper); box-shadow: none; padding: 8px 12px; font-size: 11px; }
  .head-btn:hover { background: var(--paper); color: var(--ink); transform: none; box-shadow: none; }
  .head-btn:active { transform: none; }
  .head-btn.done { background: var(--paper) !important; color: var(--ink) !important; }

  /* Drop + textarea */
  .drop {
    border: 2px dashed var(--ink); padding: 16px; margin-bottom: 16px; text-align: left;
    font: 700 11px/1.5 var(--mono); letter-spacing: .08em; text-transform: uppercase; transition: background .2s ease, color .2s ease;
  }
  .drop label { text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .drop.drag { background: var(--ink); color: var(--paper); }
  input[type=file] { display: none; }

  textarea {
    width: 100%; min-height: 400px; resize: vertical; border: var(--b) solid var(--ink); background: var(--paper);
    padding: 16px; outline: none; font: 13px/1.6 var(--mono); transition: box-shadow .2s cubic-bezier(.22,.8,.24,1), transform .2s cubic-bezier(.22,.8,.24,1);
  }
  textarea::placeholder { color: var(--gray); opacity: .8; }
  textarea:focus { box-shadow: 6px 6px 0 var(--ink); transform: translate(-3px, -3px); }

  .actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 20px; }

  /* Notice */
  .notice { display: none; margin-top: 20px; border: var(--b) solid var(--ink); padding: 12px 14px; font: 500 12px/1.5 var(--mono); align-items: flex-start; gap: 12px; }
  .notice .tag { font-weight: 700; padding: 2px 7px; letter-spacing: .1em; flex-shrink: 0; }
  .notice.success { display: flex; background: var(--paper); }
  .notice.success .tag { background: var(--ink); color: var(--paper); }
  .notice.error { display: flex; background: var(--ink); color: var(--paper); }
  .notice.error .tag { background: var(--paper); color: var(--ink); }

  /* Stats */
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: var(--b) solid var(--ink); }
  .stat { padding: 16px 20px 20px; border-right: var(--b) solid var(--ink); min-width: 0; }
  .stat:last-child { border-right: 0; }
  .stat-label { font: 700 10px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; display: flex; justify-content: space-between; margin-bottom: 18px; }
  .stat-label span:last-child { color: var(--gray); }
  .stat-value { font-size: clamp(34px, 5vw, 58px); font-weight: 800; letter-spacing: -.05em; line-height: .9; }
  .bar { height: 12px; border: 2px solid var(--ink); margin-top: 14px; }
  .bar span { display: block; height: 100%; width: 0; background: var(--ink); transition: width .9s cubic-bezier(.22,.8,.24,1); }

  /* Empty */
  .empty { min-height: 380px; padding: 32px 24px; display: flex; flex-direction: column; justify-content: flex-end; }
  .empty-big { font-size: clamp(90px, 14vw, 170px); font-weight: 800; line-height: .8; letter-spacing: -.06em; color: transparent; -webkit-text-stroke: 3px var(--ink); margin-bottom: 20px; }
  .empty strong { font-size: 20px; text-transform: uppercase; letter-spacing: .02em; font-weight: 800; }
  .empty-sub { margin-top: 8px; font: 500 12px/1.6 var(--mono); color: var(--gray); }

  /* Seed list */
  .seed-list { max-height: 640px; overflow-y: auto; }
  .seed-list::-webkit-scrollbar { width: 12px; }
  .seed-list::-webkit-scrollbar-track { background: var(--paper); border-left: 2px solid var(--ink); }
  .seed-list::-webkit-scrollbar-thumb { background: var(--ink); }
  .seed { display: grid; grid-template-columns: 76px 1fr; border-bottom: var(--b) solid var(--ink); animation: slide .5s cubic-bezier(.22,.8,.24,1) both; animation-delay: calc(var(--i, 0) * 60ms); }
  .seed:last-child { border-bottom: 0; }
  .seed-num { border-right: var(--b) solid var(--ink); padding: 16px 0; text-align: center; font: 800 28px/1 var(--mono); letter-spacing: -.04em; transition: background .2s ease, color .2s ease; }
  .seed:hover .seed-num { background: var(--ink); color: var(--paper); }
  .seed-body { padding: 16px 20px 18px; min-width: 0; }
  .seed-tag { font: 700 10px/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--gray); }
  .title { font-weight: 800; font-size: 17px; line-height: 1.3; margin: 8px 0 14px; overflow-wrap: anywhere; letter-spacing: -.01em; }
  .id { display: inline-flex; align-items: stretch; border: 2px solid var(--ink); font: 600 12px/1 var(--mono); }
  .id b { background: var(--ink); color: var(--paper); padding: 6px 8px; letter-spacing: .1em; }
  .id span { padding: 6px 10px; }
  .seed-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .seed-actions button { padding: 7px 10px; font-size: 10px; border-width: 2px; box-shadow: 3px 3px 0 var(--ink); }
  .seed-actions button:hover { box-shadow: 5px 5px 0 var(--ink); }
  .seed-actions button:active { box-shadow: 0 0 0 var(--ink); }

  /* Footer */
  .footer { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; border-top: var(--b) solid var(--ink); padding: 14px 20px; font: 700 10px/1.4 var(--mono); letter-spacing: .12em; text-transform: uppercase; }


  /* ---------- Size calculator ---------- */
  /* Category list */
  .category-btn {
    width: 100%; justify-content: space-between; text-align: left; border: 0; border-bottom: var(--b) solid var(--ink);
    box-shadow: none; padding: 16px 20px; font-size: 13px; transform: none;
  }
  .category-btn:last-child { border-bottom: 0; }
  .category-btn .n { font: 400 11px var(--mono); opacity: .6; margin-right: 14px; letter-spacing: 0; }
  .category-btn .arrow { opacity: 0; }
  .category-btn:hover, .category-btn:active { transform: none; box-shadow: inset 10px 0 0 var(--ink); }
  .category-btn.active { background: var(--ink); color: var(--paper); }
  .category-btn.active .arrow { opacity: 1; }
  .category-btn.active:hover { box-shadow: none; }

  /* Rules */
  .rule { padding: 16px 20px 18px; border-bottom: var(--b) solid var(--ink); }
  .rule:last-child { border-bottom: 0; }
  .rule-title { display: flex; gap: 10px; align-items: baseline; font-weight: 800; font-size: 13px; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 12px; }
  .rule-title .n { font: 400 11px var(--mono); opacity: .6; letter-spacing: 0; }
  .rule-formula { font: 600 12px/1.5 var(--mono); border: 2px solid var(--ink); padding: 10px 12px; margin: 0; }
  .rule-condition { font: 500 12px/1.7 var(--mono); }
  .rule-condition::before { content: "\2014\00a0"; }
  .conversion-note { font: 500 11px/1.5 var(--mono); color: var(--gray); margin: 10px 0 0; }

  /* Calculator inputs */
  .input-group { display: none; }
  .input-group.active { display: block; animation: group .45s cubic-bezier(.22,.8,.24,1) both; }
  .sides { display: grid; grid-template-columns: 1fr 1fr; border: var(--b) solid var(--ink); margin-bottom: 20px; }
  .side { padding: 16px; min-width: 0; }
  .side + .side { border-left: var(--b) solid var(--ink); }
  .side-title { display: inline-block; background: var(--ink); color: var(--paper); font: 700 10px/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; padding: 6px 8px; margin-bottom: 16px; }
  .input-item { margin-bottom: 14px; }
  .input-item:last-child { margin-bottom: 0; }
  .view-calc label { display: block; font: 700 10px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; margin-bottom: 8px; }

  .field { display: flex; border: var(--b) solid var(--ink); background: var(--paper); transition: transform .2s cubic-bezier(.22,.8,.24,1), box-shadow .2s cubic-bezier(.22,.8,.24,1); }
  .field:focus-within { transform: translate(-2px, -2px); box-shadow: 5px 5px 0 var(--ink); }
  .field input { flex: 1; min-width: 0; border: 0; outline: none; background: transparent; padding: 12px 14px; font: 500 16px var(--mono); }
  .field input::placeholder { color: var(--gray); opacity: .7; }
  input[type=number] { -moz-appearance: textfield; appearance: textfield; }
  input[type=number]::-webkit-outer-spin-button, input[type=number]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .unit-selector, .unit-static {
    display: flex; align-items: center; justify-content: center; min-width: 64px; padding: 0 12px;
    background: var(--ink); color: var(--paper); border: 0; font: 700 11px var(--mono); letter-spacing: .1em; text-transform: uppercase;
  }
  .unit-selector { -webkit-appearance: none; appearance: none; cursor: pointer; text-align: center; text-align-last: center; border-radius: 0; }
  .unit-selector option { background: var(--paper); color: var(--ink); }
  .unit-selector:focus-visible { outline: 2px solid var(--paper); outline-offset: -5px; }

  .button-group { display: flex; gap: 14px; margin-top: 4px; }
  .button-group button { flex: 1; padding: 14px; }

  /* Results */
  .calc-results { display: grid; gap: 16px; margin-top: 24px; }
  .result-item { border: var(--b) solid var(--ink); padding: 14px 16px 16px; }
  .result-title { display: flex; justify-content: space-between; font: 700 10px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; margin-bottom: 12px; }
  .result-title span:last-child { color: var(--gray); }
  .result-big { position: relative; padding: 12px 14px; font-size: clamp(34px, 5vw, 56px); font-weight: 800; letter-spacing: -.05em; line-height: .95; text-transform: uppercase; }
  .result-big.same { background: var(--ink); color: var(--paper); }
  .result-big.different { border: var(--b) solid var(--ink); padding-right: 92px; }
  .result-big.different::after { content: ""; position: absolute; top: 0; right: 0; bottom: 0; width: 64px; border-left: var(--b) solid var(--ink); background: repeating-linear-gradient(45deg, var(--ink) 0 3px, var(--paper) 3px 9px); }
  .explanation { font: 500 12px/1.6 var(--mono); color: var(--gray); margin: 10px 0 0; }
  #calculation-details { font: 500 13px/1.7 var(--mono); overflow-wrap: anywhere; }


  .view-calc h1 { font-size: clamp(40px, 7.5vw, 112px); line-height: .86; }
  .view-calc .grid { grid-template-columns: .9fr 1.1fr; }
  @keyframes group { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .result-big.reveal { animation: wipe .6s cubic-bezier(.22,.8,.24,1) both; }
  .explanation.reveal, #calculation-details.reveal { animation: appear .5s ease-out .2s both; }

  /* ---------- motion: smooth easing ---------- */
  @keyframes open  { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes flick { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
  @keyframes lineUp { from { transform: translateY(105%); } to { transform: translateY(0); } }
  @keyframes wipe  { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes appear { from { opacity: 0; } to { opacity: 1; } }
  @keyframes caret { 0%,100% { opacity: 1; } 50% { opacity: .1; } }
  @keyframes scan  { from { transform: translateX(-100%); } to { transform: translateX(560%); } }

  /* one orchestrated load: frame draws down, then headline, then panels */
  .sheet { animation: open .9s cubic-bezier(.22,.8,.24,1) backwards; }
  .meta > * { animation: flick .6s cubic-bezier(.22,.8,.24,1) .55s backwards; }
  .meta > :nth-child(2) { animation-delay: .6s; }
  .meta > :last-child { animation-delay: .7s; }
  .ln { display: block; overflow: hidden; padding-bottom: .06em; margin-bottom: -.06em; }
  :root { --off: 0s; }              /* full page-load timing */
  :root.replay { --off: -.55s; }    /* shorter timing when a tab is (re)opened */
  .ln > span { display: block; animation: lineUp .8s cubic-bezier(.22,.8,.24,1) calc(.6s + var(--off)) backwards; }
  .ln:nth-child(2) > span { animation-delay: calc(.75s + var(--off)); }
  .hero-note { animation: appear .7s ease-out calc(.95s + var(--off)) backwards; }
  .panel-head { animation: wipe .7s cubic-bezier(.22,.8,.24,1) calc(1.05s + var(--off)) backwards; }
  .panel-head.late { animation-delay: calc(1.25s + var(--off)); }
  .panel-body, .stats, .empty { animation: appear .6s ease-out calc(1.25s + var(--off)) backwards; }
  .category-btn { animation: slide .5s cubic-bezier(.22,.8,.24,1) calc(1.3s + var(--off) + var(--i, 0) * 60ms) backwards; }
  .instructions .rule { animation: slide .5s cubic-bezier(.22,.8,.24,1) calc(1.55s + var(--off) + var(--i, 0) * 60ms) backwards; }
  .caret { animation: caret 1.2s ease-in-out infinite; }

  /* responses to what you do */
  .results, .calc-results { position: relative; overflow: hidden; }
  .results.scanning::after, .calc-results.scanning::after {
    content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 18%;
    background: #fff; mix-blend-mode: difference; pointer-events: none;
    animation: scan .8s cubic-bezier(.45,0,.2,1) forwards;
  }
  .stat-value { font-variant-numeric: tabular-nums; }
  .notice.success, .notice.error { animation: appear .3s ease-out backwards; }

  @keyframes slide { from { opacity: 0; transform: translateX(-24px); } to { opacity: 1; transform: translateX(0); } }
  @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }

  @media (max-width: 850px) {
    .grid, .view-calc .grid { grid-template-columns: 1fr; }
    .panel + .panel { border-left: 0; border-top: var(--b) solid var(--ink); }
    .hero { grid-template-columns: 1fr; gap: 20px; }
    textarea { min-height: 300px; }
    .empty { min-height: 280px; }
  }
  @media (max-width: 700px) {
    .meta { grid-template-columns: 1fr 1fr; }
    .tab:nth-child(2) { border-right: 0; }
    .meta-end { grid-column: 1 / -1; border-top: var(--b) solid var(--ink); justify-content: space-between; }
  }
  @media (max-width: 520px) {
    .sheet { width: calc(100% - 20px); margin: 10px auto; }
    .meta { grid-template-columns: 1fr; }
    .meta > * { border-right: 0; border-bottom: var(--b) solid var(--ink); }
    .meta-end { border-bottom: 0; border-top: 0; flex-direction: row-reverse; }
    .stat { padding: 14px 12px; }
    .seed { grid-template-columns: 56px 1fr; }
    .seed-num { font-size: 22px; }
    .sides { grid-template-columns: 1fr; }
    .side + .side { border-left: 0; border-top: var(--b) solid var(--ink); }
    .button-group { flex-direction: column; }
  }
</style>
</head>
<body>
<div class="sheet">

  <nav class="meta" aria-label="Tools">
    <button type="button" class="tab" data-view="scanner" aria-current="page"><span class="n">01</span>Seed Scanner</button>
    <button type="button" class="tab" data-view="calc"><span class="n">02</span>Size Calculator</button>
    <div class="meta-end">
      <button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle day and night mode" aria-pressed="false">
        <span class="tt-label"><span class="n">Night</span><span class="d">Day</span></span>
        <span class="tt-track"><span class="tt-thumb"></span></span>
      </button>
      <span>V01 &middot; By Paoui</span>
    </div>
