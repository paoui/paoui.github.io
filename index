<script>
(() => {
  const input = document.getElementById('jsonInput');
  const scanBtn = document.getElementById('scanBtn');
  const clearBtn = document.getElementById('clearBtn');
  const copyAllBtn = document.getElementById('copyAllBtn');
  const exampleBtn = document.getElementById('exampleBtn');
  const fileInput = document.getElementById('fileInput');
  const dropZone = document.getElementById('dropZone');
  const notice = document.getElementById('notice');
  const productCount = document.getElementById('productCount');
  const seedCount = document.getElementById('seedCount');
  const seedRate = document.getElementById('seedRate');
  const rateBar = document.getElementById('rateBar');
  const emptyState = document.getElementById('emptyState');
  const seedList = document.getElementById('seedList');

  let seeds = [];

  // day / night toggle
  const themeBtn = document.getElementById('themeToggle');
  const root = document.documentElement;
  let themeTimer;
  const syncTheme = () => themeBtn.setAttribute('aria-pressed', String(root.dataset.theme === 'light'));
  syncTheme();
  themeBtn.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.classList.add('theme-switching');
    root.dataset.theme = next;
    syncTheme();
    try { localStorage.setItem('seed-theme', next); } catch (e) {}
    clearTimeout(themeTimer);
    themeTimer = setTimeout(() => root.classList.remove('theme-switching'), 700);
  });

  const example = {
    result: {
      dataList: [
        { dataId: 8873283001, dataType: 1, badCaseGoodsPairDTO: { goodsInfo: { goodsTitle: 'Example Product A' } } },
        { dataId: 8873283010, dataType: 2, badCaseGoodsPairDTO: { goodsInfo: { goodsTitle: 'Juste un Clou Bracelet 18K Rose Gold Small' } } },
        { dataId: 8873283020, dataType: 1, badCaseGoodsPairDTO: { goodsInfo: { goodsTitle: 'Example Product C' } } }
      ]
    }
  };

  const status = document.getElementById('status');
  const resultsPanel = document.querySelector('.results');
  resultsPanel.addEventListener('animationend', e => { if (e.animationName === 'scan') resultsPanel.classList.remove('scanning'); });

  // eased count-up
  function countTo(el, to, decimals = 0, suffix = '') {
    const fmt = v => (decimals ? v.toFixed(decimals) : Math.round(v).toLocaleString()) + suffix;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || to === 0) { el.textContent = fmt(to); return; }
    const start = performance.now(), dur = 900;
    const tick = now => {
      const t = Math.min(1, (now - start) / dur);
      el.textContent = fmt(to * (1 - Math.pow(1 - t, 4)));
      if (t < 1) requestAnimationFrame(tick); else el.textContent = fmt(to);
    };
    requestAnimationFrame(tick);
  }

  function setEmpty(kind) {
    const none = kind === 'none';
    emptyState.hidden = false;
    emptyState.innerHTML = `
      <div class="empty-big">00</div>
      <strong>${none ? 'No seeds found' : 'No scan yet'}</strong>
      <div class="empty-sub">${none ? 'No items with <code>dataType: 2</code> were found in this response.' : 'Your extracted seeds will appear here.'}</div>`;
  }

  function showNotice(message, type = 'error') {
    notice.className = 'notice ' + type;
    notice.innerHTML = `<b class="tag">${type === 'success' ? 'OK' : 'ERR'}</b>`;
    const span = document.createElement('span');
    span.textContent = message;
    notice.appendChild(span);
  }
  function clearNotice() { notice.textContent = ''; notice.className = 'notice'; }

  function extract(data) {
    const items = data?.result?.dataList;
    if (!Array.isArray(items)) throw new Error('Could not find result.dataList in this JSON. Make sure you pasted the outer-list response.');
    const found = items.filter(item => item?.dataType === 2).map(item => ({
      dataId: item?.dataId ?? '—',
      productTitle: item?.badCaseGoodsPairDTO?.goodsInfo?.goodsTitle ?? '(No product title found)'
    }));
    return { total: items.length, found };
  }

  function render(total, found) {
    seeds = found;
    const rate = total ? (found.length / total) * 100 : 0;
    countTo(productCount, total);
    countTo(seedCount, found.length);
    countTo(seedRate, rate, 1, '%');
    status.textContent = found.length + (found.length === 1 ? ' seed' : ' seeds');
    resultsPanel.classList.remove('scanning'); void resultsPanel.offsetWidth; resultsPanel.classList.add('scanning');
    rateBar.style.width = Math.min(rate, 100) + '%';
    copyAllBtn.disabled = found.length === 0;

    if (!found.length) {
      setEmpty('none');
      seedList.hidden = true;
      seedList.innerHTML = '';
      return;
    }

    emptyState.hidden = true;
    seedList.hidden = false;
    seedList.innerHTML = found.map((seed, i) => `
      <article class="seed" style="--i:${i}">
        <div class="seed-num">${String(i + 1).padStart(2, '0')}</div>
        <div class="seed-body">
          <div class="seed-tag">Seed item</div>
          <div class="title">${escapeHtml(seed.productTitle)}</div>
          <div class="id"><b>ID</b><span>${escapeHtml(String(seed.dataId))}</span></div>
          <div class="seed-actions">
            <button data-copy-title="${i}"><span class="label">Copy Title</span></button>
            <button data-copy-id="${i}"><span class="label">Copy ID</span></button>
          </div>
        </div>
      </article>
    `).join('');

    seedList.querySelectorAll('[data-copy-title]').forEach(btn => btn.addEventListener('click', () => copyText(seeds[btn.dataset.copyTitle].productTitle, btn)));
    seedList.querySelectorAll('[data-copy-id]').forEach(btn => btn.addEventListener('click', () => copyText(String(seeds[btn.dataset.copyId].dataId), btn)));
  }

  function escapeHtml(value) {
    return String(value).replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
  }

  async function copyText(text, button) {
    try {
      await navigator.clipboard.writeText(text);
      const label = button.querySelector('.label');
      const old = label.textContent;
      label.textContent = 'Copied';
      button.classList.add('done');
      setTimeout(() => { label.textContent = old; button.classList.remove('done'); }, 900);
    } catch {
      showNotice('Clipboard access was blocked by the browser. You can select and copy the text manually.', 'error');
    }
  }

  scanBtn.addEventListener('click', () => {
    clearNotice();
    const raw = input.value.trim();
    if (!raw) { showNotice('Paste the outer-list JSON first.'); return; }
    try {
      const data = JSON.parse(raw);
      const result = extract(data);
      render(result.total, result.found);
      showNotice(`Scan complete — ${result.found.length} seed${result.found.length === 1 ? '' : 's'} found.`, 'success');
    } catch (err) {
      showNotice(err instanceof Error ? err.message : 'Unable to read this JSON.');
    }
  });

  clearBtn.addEventListener('click', () => {
    input.value = '';
    seeds = [];
    productCount.textContent = '—'; seedCount.textContent = '—'; seedRate.textContent = '—';
    rateBar.style.width = '0';
    status.textContent = 'Idle';
    copyAllBtn.disabled = true;
    seedList.hidden = true; seedList.innerHTML = '';
    setEmpty('idle');
    clearNotice();
  });

  copyAllBtn.addEventListener('click', () => {
    const text = seeds.map((s, i) => `${i + 1}. ${s.productTitle}\n   Data ID: ${s.dataId}`).join('\n\n');
    copyText(text, copyAllBtn);
  });

  exampleBtn.addEventListener('click', () => {
    input.value = JSON.stringify(example, null, 2);
    clearNotice();
    scanBtn.click();
  });

  fileInput.addEventListener('change', async e => {
    const file = e.target.files?.[0];
    if (!file) return;
    input.value = await file.text();
    clearNotice();
  });

  ['dragenter','dragover'].forEach(event => dropZone.addEventListener(event, e => { e.preventDefault(); dropZone.classList.add('drag'); }));
  ['dragleave','drop'].forEach(event => dropZone.addEventListener(event, e => { e.preventDefault(); dropZone.classList.remove('drag'); }));
  dropZone.addEventListener('drop', async e => {
    const file = e.dataTransfer.files?.[0];
    if (!file) return;
    input.value = await file.text();
    clearNotice();
  });

  setEmpty('idle');
})();
</script>
<script>
(() => {

  const $$ = sel => document.querySelectorAll(sel);
  const $  = sel => document.querySelector(sel);

  // ----- feedback helpers (same patterns as the scanner) -----
  const calcResults = $('.calc-results');
  const calcNotice = $('#calcNotice');
  function showCalcNotice(message) {
    calcNotice.className = 'notice error';
    calcNotice.innerHTML = '<b class="tag">ERR</b>';
    const span = document.createElement('span');
    span.textContent = message;
    calcNotice.appendChild(span);
  }
  function clearCalcNotice() { calcNotice.textContent = ''; calcNotice.className = 'notice'; }
  function restart(el, cls) { el.classList.remove(cls); void el.offsetWidth; el.classList.add(cls); }
  function playResult() {
    restart(calcResults, 'scanning');
    restart($('#result-text'), 'reveal');
    restart($('#result-explanation'), 'reveal');
    restart($('#calculation-details'), 'reveal');
  }
  calcResults.addEventListener('animationend', e => { if (e.animationName === 'scan') calcResults.classList.remove('scanning'); });

  // Reads an input and always returns centimetres when the field has a unit selector
  const getVal = sel => {
    const el = $(sel);
    let v = parseFloat(el.value) || 0;
    const unit = document.querySelector(`.unit-selector[data-target="${el.id}"]`);
    if (unit && unit.value === 'inch') v *= 2.54;
    return v;
  };

  // Unit conversion: keeps the physical size the same when the unit is switched
  $$('.unit-selector').forEach(sel =>
    sel.addEventListener('change', e => {
      const id = e.target.dataset.target;
      const inp = $(`#${id}`);
      const v = parseFloat(inp.value);
      if (!isNaN(v))
        inp.value = (e.target.value === 'inch' ? v / 2.54 : v * 2.54).toFixed(2);
      const label = $(`.u[data-for="${id}"]`);
      if (label) label.textContent = e.target.value;
    })
  );

  // Switch categories
  $$('.category-btn').forEach(btn =>
    btn.addEventListener('click', () => {
      $$('.category-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      $$('.input-group').forEach(g => g.classList.remove('active'));
      $(`#${btn.dataset.category}-input`).classList.add('active');
      reset();
    })
  );

  function reset() {
    clearCalcNotice();
    $$('input[type=number]').forEach(i => i.value = '');
    $('#result-text').textContent = '-';
    $('#result-text').className = 'result-big';
    $('#result-explanation').textContent = 'Waiting for calculation...';
    $('#calculation-details').textContent = '-';
  }

  $('#reset').addEventListener('click', reset);

  $('#calculate').addEventListener('click', () => {
    clearCalcNotice();
    const cat = $('.category-btn.active').dataset.category;
    let ok = false, detail = '';
    const n = x => +x.toFixed(2);

    switch (cat) {
      case 'bag': {
        const ll = getVal('#bag-left-length'), lw = getVal('#bag-left-width'), lh = getVal('#bag-left-height');
        const rl = getVal('#bag-right-length'), rw = getVal('#bag-right-width'), rh = getVal('#bag-right-height');
        if (!(ll && lw && lh && rl && rw && rh)) return showCalcNotice('Please enter all values.');
        const lv = ll * lw * lh, rv = rl * rw * rh, r = rv / lv;
        detail = `Left item volume=${lv.toFixed(2)} cm³, Right item volume=${rv.toFixed(2)} cm³, Ratio=${r.toFixed(3)}`;
        ok = r > 0.8 && r < 1.2;
        break;
      }
      case 'clothing': {
        const l = getVal('#clothing-left'), r = getVal('#clothing-right');
        if (!(l && r)) return showCalcNotice('Please enter all values.');
        detail = `Left item=${l.toFixed(1)} g, Right item=${r.toFixed(1)} g`;
        if (r > l) { ok = true; detail += ' → Right item>Left item, directly same'; }
        else if (l <= 200) { ok = r >= l * 0.95; detail += ` → Need Right item≥${(l * 0.95).toFixed(1)} g`; }
        else { ok = r >= l - 10; detail += ` → Need Right item≥${(l - 10).toFixed(1)} g`; }
        break;
      }
      case 'metal': {
        const l = getVal('#metal-left'), r = getVal('#metal-right');
        if (!(l && r)) return showCalcNotice('Please enter all values.');
        const ratio = r / l;
        detail = `Left item=${l} g, Right item=${r} g, Ratio=${ratio.toFixed(3)}`;
        ok = ratio > 0.9 && ratio < 1.1;
        break;
      }
      case 'accessory': {
        const l = getVal('#accessory-left'), r = getVal('#accessory-right');
        if (!(l && r)) return showCalcNotice('Please enter all values.');
        const ratio = r / l;
        detail = `Left item=${n(l)} cm, Right item=${n(r)} cm, Ratio=${ratio.toFixed(3)}`;
        ok = ratio > 0.9 && ratio < 1.1;
        break;
      }
      case 'belt': {
        // Width
        const lw = getVal('#belt-left-width'), rw = getVal('#belt-right-width');
        let wOk = true, wMsg = '';
        if (lw && rw) {
          const wr = rw / lw;
          wOk = wr > 0.9 && wr < 1.1;
          wMsg = `Width ratio=${wr.toFixed(2)} (${wOk ? 'pass' : 'fail'})`;
        } else { wMsg = 'Width not entered'; }

        // Thickness
        const lt = getVal('#belt-left-thickness'), rt = getVal('#belt-right-thickness');
        let tOk = true, tMsg = '';
        if (lt && rt) {
          const tr = rt / lt;
          tOk = tr > 0.9 && tr < 1.1;
          tMsg = `Thickness ratio=${tr.toFixed(2)} (${tOk ? 'pass' : 'fail'})`;
        } else { tMsg = 'Thickness not entered'; }

        // Length
        const ll = getVal('#belt-left-length'), rl = getVal('#belt-right-length');
        let lOk = true, lMsg = '';
        if (ll && rl) {
          const ld = Math.abs(rl - ll), lr = rl / ll;
          lOk = ld < 30 && lr > 0.8 && lr < 1.2;
          lMsg = `Length difference=${ld.toFixed(1)} cm, Length ratio=${lr.toFixed(2)} (${lOk ? 'pass' : 'fail'})`;
        } else { lMsg = 'Length not entered'; }

        // All entered items must be qualified
        ok = wOk && tOk && lOk;
        detail = [wMsg, tMsg, lMsg].join(' | ');
        break;
      }
    }

    $('#result-text').textContent = ok ? 'Same' : 'Not Same';
    $('#result-text').className = ok ? 'result-big same' : 'result-big different';
    $('#result-explanation').textContent = ok ? 'Left item and right item data are within the allowed difference range' : 'Data exceeds the allowed difference range';
    $('#calculation-details').textContent = detail;
    playResult();
  });

  // Keyboard navigation
  document.addEventListener('keydown', function (e) {
    // Only act inside the calculator (the scanner tab has its own controls)
    if (!(e.target.closest && e.target.closest('#view-calc'))) return;

    // Enter inside a field runs the calculation (buttons keep their normal Enter behaviour)
    if (e.key === 'Enter' && e.target.tagName !== 'BUTTON') {
      e.preventDefault();
      $('#calculate').click();
    }

    // Arrow key navigation (only for input fields)
    if (e.target.classList.contains('nav-input') &&
        ['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key)) {

      e.preventDefault();
      const currentInput = e.target;
      const row = parseInt(currentInput.dataset.row);
      const col = parseInt(currentInput.dataset.col);
      const activeGroup = document.querySelector('.input-group.active');

      let nextInput = null;

      switch (e.key) {
        case 'ArrowUp':
          if (row > 0) {
            nextInput = activeGroup.querySelector(`.nav-input[data-row="${row - 1}"][data-col="${col}"]`);
          }
          break;
        case 'ArrowDown':
          nextInput = activeGroup.querySelector(`.nav-input[data-row="${row + 1}"][data-col="${col}"]`);
          if (!nextInput) {
            // Try the first row in the same column
            const firstInCol = activeGroup.querySelector(`.nav-input[data-col="${col}"]`);
            if (firstInCol) nextInput = firstInCol;
          }
          break;
        case 'ArrowLeft':
          if (col > 0) {
            nextInput = activeGroup.querySelector(`.nav-input[data-row="${row}"][data-col="${col - 1}"]`);
          }
          break;
        case 'ArrowRight':
          nextInput = activeGroup.querySelector(`.nav-input[data-row="${row}"][data-col="${col + 1}"]`);
          if (!nextInput) {
            // Try the first column in the next row
            nextInput = activeGroup.querySelector(`.nav-input[data-row="${row + 1}"][data-col="0"]`);
          }
          break;
      }

      if (nextInput) {
        nextInput.focus();
        nextInput.select();
      }
    }
  });

})();
</script>
<script>
(() => {
  const root = document.documentElement;
  const tabs = [...document.querySelectorAll('.tab')];
  const views = { scanner: document.getElementById('view-scanner'), calc: document.getElementById('view-calc') };
  const hashes = { scanner: 'seed-scanner', calc: 'size-calculator' };
  const titles = { scanner: 'Seed Scanner', calc: 'Size Difference Calculator' };
  let current = 'scanner';

  function activate(name, replay) {
    if (!views[name] || name === current) return;
    current = name;
    if (replay) root.classList.add('replay');   // shorter entrance timing after the first load
    Object.entries(views).forEach(([key, el]) => { el.hidden = key !== name; });
    tabs.forEach(t => {
      if (t.dataset.view === name) t.setAttribute('aria-current', 'page');
      else t.removeAttribute('aria-current');
    });
    document.title = titles[name];
  }

  tabs.forEach(t => t.addEventListener('click', () => {
    activate(t.dataset.view, true);
    try { history.replaceState(null, '', '#' + hashes[t.dataset.view]); } catch (e) {}
  }));

  const fromHash = () => Object.keys(hashes).find(k => '#' + hashes[k] === location.hash);
  const start = fromHash();
  if (start) activate(start, false);
  window.addEventListener('hashchange', () => { const k = fromHash(); if (k) activate(k, true); });
})();
</script>
